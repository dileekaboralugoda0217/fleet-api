# Example Environment Configuration for Fleet Management API
# Copy this file to .env or set these environment variables in your environment if custom configuration is needed.

# Application Server Port
SERVER_PORT=8080

# SQLite Database JDBC URL (file-based persistence)
SPRING_DATASOURCE_URL=jdbc:sqlite:fleet.db

# Hibernate DDL Auto mode (update / validate)
SPRING_JPA_HIBERNATE_DDL_AUTO=update
